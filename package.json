{
  "name": "buku-platform",
  "version": "0.1.0",
  "private": true,
  "description": "BUKU \u2014 universal appointment booking and virtual queue platform",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12.8.0"
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "bash scripts/setup-dev.sh",
    "dev": "docker compose -f docker-compose.dev.yml up -d",
    "web": "pnpm --filter @buku/web dev",
    "web:e2e": "pnpm --filter @buku/web e2e",
    "dev:tools": "docker compose -f docker-compose.dev.yml --profile tools up -d",
    "dev:full": "docker compose -f docker-compose.dev.yml --profile '*' up -d",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f --tail=100",
    "dev:down": "docker compose -f docker-compose.dev.yml --profile '*' down",
    "dev:wipe": "docker compose -f docker-compose.dev.yml --profile '*' down -v",
    "health": "bash scripts/health-check.sh",
    "verify": "bash scripts/verify.sh",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:hidden": "tsx scripts/check-hidden-chars.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @buku/web typecheck",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "pnpm --filter @buku/database generate",
    "db:migrate:dev": "pnpm --filter @buku/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @buku/database migrate:deploy",
    "db:seed": "pnpm --filter @buku/database seed",
    "db:studio": "pnpm --filter @buku/database studio",
    "kafka:topics": "pnpm --filter @buku/kafka topics:sync",
    "changeset": "changeset",
    "audit:deps": "pnpm audit --audit-level high",
    "prisma:validate": "pnpm --filter @buku/database validate",
    "acceptance": "tsx scripts/acceptance/run.ts",
    "admin:role": "pnpm --filter @buku/auth-service exec tsx scripts/set-role.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
