# BUKU admin app (D-091). Copy to .env.local for development.
# Production: its own Vercel project and domain (e.g. https://admin.buku.app), never the website's.

# This app's own address.
APP_URL=http://localhost:3200

# The API gateway.
API_URL=http://localhost:8000

# The admin app's gateway key: the SAME value as ADMIN_GATEWAY_KEY in the API's (Kong's)
# environment. Without it every admin route answers 404. ⚠ A secret: only here and in Kong,
# never in the public website's settings.
ADMIN_GATEWAY_KEY=

# The header the hosting platform puts the visitor's address in. ⚠ PROD on Vercel: x-real-ip (Vercel
# sets it; a visitor can't). In development nothing sets it: browser tests send their own, so each
# test is a separate visitor to the API's sign-in limits.
ADMIN_CLIENT_IP_HEADER=x-real-ip

# Development sign-in (any email becomes a platform admin). Refused when VERCEL_ENV=production.
DEV_SIGN_IN=true
