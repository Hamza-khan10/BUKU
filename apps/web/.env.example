# ═══════════════════════════════════════════════════════════════════════════
# BUKU web app — server settings (copy to .env.local for development).
# None of these reach the browser. On Vercel, set them in the project's
# Environment Variables (Production and Preview).
# ═══════════════════════════════════════════════════════════════════════════

# This site's own origin. ⚠ PROD: https://<your domain>
APP_URL=http://localhost:3000

# The API gateway (Kong). ⚠ PROD: https://api.<your domain>
API_URL=http://localhost:8000

# Shared with the gateway: lets this server pass on visitors' real addresses
# (D-084). The SAME value as WEB_GATEWAY_KEY in the API's environment.
WEB_GATEWAY_KEY=

# The header your host puts the visitor's address in. ⚠ PROD on Vercel: x-real-ip
# Leave empty in development (there is no proxy in front of `next dev`).
WEB_CLIENT_IP_HEADER=

# Where pictures are served from (object storage), for the Content-Security-Policy.
MEDIA_ORIGIN=http://localhost:9100

# Development sign-in (any email, no Google). Refused when VERCEL_ENV=production.
DEV_SIGN_IN=true

# Let search engines index the site. ⚠ PROD: true only on the launch domain.
ALLOW_INDEXING=false

# ── Who runs BUKU (legal and contact pages) ───────────────────────────────
# Until these are set, the pages say the details are published before launch.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
SECURITY_EMAIL=
# true only after a lawyer has reviewed the legal pages (until then: marked "Draft").
LEGAL_REVIEWED=false
