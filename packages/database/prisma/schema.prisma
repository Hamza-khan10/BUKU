// ═════════════════════════════ IDENTITY ═════════════════════════════

/// A person using BUKU. Consumers, staff and business owners are all users; `role` is their highest role.
/// DB extras: CHECK at least one of email_hash / phone_hash; updated_at trigger.
model User {
  id                       String     @id @default(uuid(7)) @db.Uuid
  /// AES-256-GCM ciphertext, context "users.email".
  emailEncrypted           String?    @map("email_encrypted")
  /// HMAC-SHA256 blind index of the normalized email (lookups + uniqueness).
  emailHash                String?    @unique @map("email_hash") @db.Char(64)
  /// AES-256-GCM ciphertext, context "users.phone".
  phoneEncrypted           String?    @map("phone_encrypted")
  phoneHash                String?    @unique @map("phone_hash") @db.Char(64)
  /// Phone added after sign-up, not yet verified by OTP (context "users.unverified_phone").
  /// Deliberately NOT unique: an unverified claim must not let anyone block someone
  /// else's number. Moves to phone_* once verification exists (SMS/WhatsApp OTP).
  unverifiedPhoneEncrypted String?    @map("unverified_phone_encrypted")
  unverifiedPhoneHash      String?    @map("unverified_phone_hash") @db.Char(64)
  /// Explicit WhatsApp opt-in (required by WhatsApp Business policy), with timestamp.
  whatsappOptInAt          DateTime?  @map("whatsapp_opt_in_at") @db.Timestamptz(6)
  /// Argon2id PHC string. Null for OTP-only / social-login accounts.
  passwordHash             String?    @map("password_hash") @db.VarChar(255)
  name                     String     @db.VarChar(200)
  /// Picture from the sign-in provider (e.g. Google), shown only to the user themself.
  avatarUrl                String?    @map("avatar_url")
  /// Uploaded profile picture (cleaned, PRIVATE bucket): visible only to the user themself (D-051).
  avatarStorageKey         String?    @unique @map("avatar_storage_key") @db.VarChar(300)
  timezone                 String     @default("UTC") @db.VarChar(60)
  locale                   String     @default("en") @db.VarChar(10)
  role                     UserRole   @default(user)
  status                   UserStatus @default(active)
  emailVerifiedAt          DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt          DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  /// GDPR/legal: which Terms version the user accepted, and when.
  termsVersion             String?    @map("terms_version") @db.VarChar(20)
  termsAcceptedAt          DateTime?  @map("terms_accepted_at") @db.Timestamptz(6)
  passwordChangedAt        DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  /// Employee accounts (D-034): created by a business for its staff, they sign in with
  /// business + username + password and exist only for that business.
  managedByBusinessId      String?    @map("managed_by_business_id") @db.Uuid
  /// Unique within the managing business; lowercase letters, digits, ".", "_", "-".
  username                 String?    @db.VarChar(40)
  /// Set when the business issues a temporary password; the account has no business
  /// access until the employee chooses their own.
  mustChangePassword       Boolean    @default(false) @map("must_change_password")
  /// Consecutive wrong passwords; reaching the limit locks sign-in until `lockedUntil`.
  failedLoginCount         Int        @default(0) @map("failed_login_count")
  lockedUntil              DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt              DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Account deletion requested (GDPR erasure). The account is hidden immediately and can be
  /// restored by signing in during the grace period; after it, personal data is purged.
  deletedAt                DateTime?  @map("deleted_at") @db.Timestamptz(6)
  /// When personal data was irreversibly anonymized after the grace period.
  purgedAt                 DateTime?  @map("purged_at") @db.Timestamptz(6)
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  pushTokens         PushToken[]
  notificationPrefs  NotificationPreference?
  ownedBusinesses    Business[]              @relation("BusinessOwner")
  staffProfiles      Staff[]
  appointments       Appointment[]
  payments           Payment[]
  reviews            Review[]
  favourites         Favourite[]
  queueEntries       QueueEntry[]
  notifications      Notification[]
  whatsappContact    WhatsappContact?
  notificationMarks  NotificationMark[]
  auditLogs          AuditLog[]
  reviewedDocuments  BusinessDocument[]      @relation("DocumentReviewer")
  memberships        BusinessMember[]        @relation("MemberUser")
  createdMembers     BusinessMember[]        @relation("MemberCreatedBy")
  businessReports    BusinessReport[]        @relation("Reporter")
  reviewedReports    BusinessReport[]        @relation("ReportReviewer")
  staffPhotoConsents StaffPhoto[]            @relation("StaffPhotoConsent")
  checkIns           Appointment[]           @relation("AppointmentCheckIn")
  subscriptions      Subscription[]          @relation("UserSubscriptions")
  subscriptionGrants Subscription[]          @relation("SubscriptionGrantedBy")
  planRequests       PlanRequest[]           @relation("PlanRequestedBy")
  planDecisions      PlanRequest[]           @relation("PlanRequestDecidedBy")
  shiftsRecorded     StaffAttendance[]       @relation("AttendanceRecordedBy")
  managedByBusiness  Business?               @relation("ManagedAccounts", fields: [managedByBusinessId], references: [id], onDelete: Restrict)

  @@unique([managedByBusinessId, username])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([unverifiedPhoneHash])
  @@map("users")
}

/// Links a user to an external identity (Google `sub`, Apple `sub`).
model OAuthAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Refresh tokens are stored as SHA-256(token) — never the token itself.
/// Rotation: each use revokes the token and issues a new one in the same `familyId`.
/// Reuse of an already-rotated token revokes the whole family (theft detection).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  deviceInfo    Json?     @map("device_info")
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PushToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  isActive   Boolean        @default(true) @map("is_active")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_tokens")
}

/// One row per user. `sms_queue_called` is intentionally absent: being called
/// in a queue is a transactional message that cannot be disabled.
model NotificationPreference {
  userId                   String    @id @map("user_id") @db.Uuid
  pushBookingConfirmation  Boolean   @default(true) @map("push_booking_confirmation")
  pushReminders            Boolean   @default(true) @map("push_reminders")
  pushQueueUpdates         Boolean   @default(true) @map("push_queue_updates")
  /// Team members: new booking requests, bookings and cancellations at their business.
  pushBusinessAlerts       Boolean   @default(true) @map("push_business_alerts")
  /// Key messages by WhatsApp (also needs the WhatsApp consent recorded on the account).
  whatsappUpdates          Boolean   @default(true) @map("whatsapp_updates")
  smsReminders             Boolean   @default(true) @map("sms_reminders")
  emailBookingConfirmation Boolean   @default(true) @map("email_booking_confirmation")
  /// Reminders by email (24 h before; and as a fallback when the person has no app installed).
  emailReminders           Boolean   @default(true) @map("email_reminders")
  /// Team members without the app (web dashboard only): booking alerts by email.
  emailBusinessAlerts      Boolean   @default(true) @map("email_business_alerts")
  /// Suggestions based on how they use BUKU ("time for your usual haircut?", "Fade Studio has
  /// openings"): in the app, push and WhatsApp. Opt-in (app-store rules for promotional push);
  /// consent timestamp recorded. By email they also need `marketingEmails`.
  suggestions              Boolean   @default(false)
  suggestionsConsentAt     DateTime? @map("suggestions_consent_at") @db.Timestamptz(6)
  /// GDPR: marketing requires explicit opt-in; consent timestamp recorded.
  marketingEmails          Boolean   @default(false) @map("marketing_emails")
  marketingConsentAt       DateTime? @map("marketing_consent_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ═════════════════════════════ CATALOG ═════════════════════════════

/// Self-referencing tree (depth 0 = top level). DB extras: CHECK depth >= 0.
model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  icon      String?  @db.VarChar(10)
  parentId  String?  @map("parent_id") @db.Uuid
  depth     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent     Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]   @relation("CategoryTree")
  businesses Business[]
  ads        BusinessAd[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

/// DB extras: `location` and `search_vector` are maintained by a BEFORE trigger (from lat/lng
/// and name/description/city); GiST + GIN + trigram indexes; rating trigger.
model Business {
  id                      String                                @id @default(uuid(7)) @db.Uuid
  ownerId                 String                                @map("owner_id") @db.Uuid
  categoryId              String                                @map("category_id") @db.Uuid
  name                    String                                @db.VarChar(200)
  slug                    String                                @unique @db.VarChar(200)
  description             String?
  /// Cleaned logo in the media bucket (shown next to the cover photo).
  logoStorageKey          String?                               @unique @map("logo_storage_key") @db.VarChar(300)
  phone                   String?                               @db.VarChar(20)
  email                   String?                               @db.VarChar(255)
  website                 String?                               @db.VarChar(500)
  address                 String?
  city                    String                                @db.VarChar(100)
  state                   String?                               @db.VarChar(100)
  /// ISO 3166-1 alpha-2 code, e.g. "PK". DB extras: CHECK ^[A-Z]{2}$.
  country                 String                                @db.Char(2)
  postalCode              String?                               @map("postal_code") @db.VarChar(20)
  lat                     Decimal?                              @db.Decimal(10, 8)
  lng                     Decimal?                              @db.Decimal(11, 8)
  /// Derived from lat/lng by a DB trigger. Never written by the application.
  location                Unsupported("geography(Point,4326)")?
  /// Full-text vector maintained by a DB trigger. Never written by the application.
  searchVector            Unsupported("tsvector")?              @map("search_vector")
  /// IANA timezone. All availability math happens in this zone.
  timezone                String                                @default("UTC") @db.VarChar(60)
  currency                String                                @default("USD") @db.Char(3)
  status                  BusinessStatus                        @default(pending)
  verified                Boolean                               @default(false)
  verifiedAt              DateTime?                             @map("verified_at") @db.Timestamptz(6)
  rejectionReason         String?                               @map("rejection_reason")
  /// Validated by a Zod schema in the service layer (autoConfirm, cancellationHours, ...).
  settings                Json                                  @default("{}")
  avgRating               Decimal                               @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount             Int                                   @default(0) @map("review_count")
  /// Business Terms version accepted by the owner at registration, and when.
  businessTermsVersion    String?                               @map("business_terms_version") @db.VarChar(20)
  businessTermsAcceptedAt DateTime?                             @map("business_terms_accepted_at") @db.Timestamptz(6)
  deletedAt               DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                  User                    @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos                 BusinessPhoto[]
  staffPhotos            StaffPhoto[]
  serviceCategories      ServiceCategory[]
  staffAttendance        StaffAttendance[]
  queueSettings          QueueSettings?
  planRequests           PlanRequest[]
  bookingSettings        BookingSettings?
  documents              BusinessDocument[]
  hours                  BusinessHours[]
  services               Service[]
  staff                  Staff[]
  resources              Resource[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  payments               Payment[]
  reviews                Review[]
  favourites             Favourite[]
  queueSessions          QueueSession[]
  ads                    BusinessAd[]
  adEvents               AdEvent[]
  aiReceptionistConfig   AiReceptionistConfig?
  aiCallLogs             AiCallLog[]
  webhooks               Webhook[]
  subscriptions          Subscription[]
  legalProfile           BusinessLegalProfile?
  members                BusinessMember[]
  managedAccounts        User[]                  @relation("ManagedAccounts")
  reports                BusinessReport[]
  searchStats            BusinessSearchStats?

  @@index([ownerId])
  @@index([categoryId])
  @@index([status, verified])
  @@index([city, country])
  @@index([avgRating])
  @@index([createdAt])
  @@index([location], type: Gist)
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "businesses_name_trgm_idx")
  @@map("businesses")
}

/// Public photos. Stored in the media bucket under `businesses/<id>/photos/<photoId>`;
/// shown only once the upload is confirmed and verified to be a real image (uploadedAt set).
model BusinessPhoto {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  storageKey  String    @unique @map("storage_key") @db.VarChar(300)
  contentType String    @map("content_type") @db.VarChar(100)
  sizeBytes   Int       @map("size_bytes")
  altText     String?   @map("alt_text") @db.VarChar(300)
  isPrimary   Boolean   @default(false) @map("is_primary")
  sortOrder   Int       @default(0) @map("sort_order")
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_photos")
}

/// An employee's photo, shown next to their name so customers recognise them (D-051).
/// Optional and the business's choice, with the employee's consent; owned by business-service
/// (all business media), keyed by the staff profile (booking-service).
model StaffPhoto {
  id                   String   @id @default(uuid(7)) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  staffId              String   @map("staff_id") @db.Uuid
  /// Cleaned picture in the media bucket.
  storageKey           String   @unique @map("storage_key") @db.VarChar(300)
  sizeBytes            Int      @map("size_bytes")
  /// Who confirmed the employee agreed to have their photo shown, and when.
  consentConfirmedById String?  @map("consent_confirmed_by_id") @db.Uuid
  consentConfirmedAt   DateTime @map("consent_confirmed_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Composite key: the staff member must belong to the same business.
  staff              Staff    @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)
  consentConfirmedBy User?    @relation("StaffPhotoConsent", fields: [consentConfirmedById], references: [id], onDelete: SetNull)

  /// One photo per staff member (a staff id belongs to exactly one business).
  @@unique([staffId, businessId])
  @@index([businessId])
  @@map("staff_photos")
}

/// Verification documents in the PRIVATE documents bucket (`businesses/<id>/documents/<docId>`);
/// never public, viewed by admins only through short-lived presigned links.
model BusinessDocument {
  id           String         @id @default(uuid(7)) @db.Uuid
  businessId   String         @map("business_id") @db.Uuid
  type         DocumentType
  storageKey   String         @unique @map("storage_key") @db.VarChar(300)
  contentType  String         @map("content_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  uploadedAt   DateTime?      @map("uploaded_at") @db.Timestamptz(6)
  status       DocumentStatus @default(awaiting_upload)
  reviewedById String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?        @map("review_note")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status, createdAt])
  @@map("business_documents")
}

/// Public opening hours. Multiple rows per day allowed (split shifts).
/// DB extras: CHECK day 0-6, HH:MM format, open < close.
/// What search ranks by (D-076), recomputed by search-service every 10 minutes from
/// bookings and queues. Derived data: safe to delete, rebuilt on the next run.
model BusinessSearchStats {
  businessId         String   @id @map("business_id") @db.Uuid
  /// Bookings made in the last 7 days / the 7 before (excluding ones the business itself cancelled).
  bookings7d         Int      @default(0) @map("bookings_7d")
  bookingsPrev7d     Int      @default(0) @map("bookings_prev_7d")
  queueJoins7d       Int      @default(0) @map("queue_joins_7d")
  /// Last 90 days: visits kept (completed, checked in, or the customer didn't come) and
  /// confirmed bookings the business cancelled. Reliability = kept / (kept + cancelled).
  kept90d            Int      @default(0) @map("kept_90d")
  businessCancels90d Int      @default(0) @map("business_cancels_90d")
  refreshedAt        DateTime @map("refreshed_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([bookings7d])
  @@map("business_search_stats")
}

model BusinessHours {
  id         String  @id @default(uuid(7)) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  dayOfWeek  Int     @map("day_of_week") @db.SmallInt
  openTime   String  @map("open_time") @db.VarChar(5)
  closeTime  String  @map("close_time") @db.VarChar(5)
  isClosed   Boolean @default(false) @map("is_closed")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek, openTime])
  @@map("business_hours")
}

/// DB extras: CHECK duration 5..1440, buffer 0..240, max_concurrent 1..100, price/deposit >= 0.
model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  name            String   @db.VarChar(200)
  description     String?
  durationMinutes Int      @map("duration_minutes")
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  maxConcurrent   Int      @default(1) @map("max_concurrent")
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD") @db.Char(3)
  depositRequired Boolean  @default(false) @map("deposit_required")
  depositAmount   Decimal? @map("deposit_amount") @db.Decimal(10, 2)
  /// Optional category within the business ("Haircuts", "Colour", ...).
  categoryId      String?  @map("category_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Composite key: a service can only be in a category of its own business.
  category     ServiceCategory? @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  staff        StaffService[]
  appointments Appointment[]

  @@index([businessId, isActive, sortOrder])
  @@index([categoryId])
  @@map("services")
}

/// A business groups its services into categories (product decision: several per business).
model ServiceCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String   @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@map("service_categories")
}

/// Employee shifts: clocking in and out (decision C). At most one open shift per person.
/// Owned by booking-service; also tells the queue who is present (2.4).
model StaffAttendance {
  id           String    @id @default(uuid(7)) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  checkInAt    DateTime  @map("check_in_at") @db.Timestamptz(6)
  checkOutAt   DateTime? @map("check_out_at") @db.Timestamptz(6)
  /// Who last recorded or corrected this shift (the employee, front desk or a manager).
  recordedById String?   @map("recorded_by_id") @db.Uuid
  note         String?   @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Composite key: the shift belongs to an employee of the same business.
  staff      Staff    @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)
  recordedBy User?    @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([businessId, checkInAt])
  @@index([staffId, checkInAt])
  @@map("staff_attendance")
}

/// How a business takes bookings (owned by booking-service). No row → the defaults below.
model BookingSettings {
  businessId                   String           @id @map("business_id") @db.Uuid
  /// automatic: bookings are confirmed at once; manual: the business approves each one.
  confirmationMode             ConfirmationMode @default(automatic) @map("confirmation_mode")
  /// How far ahead customers may book (D-037).
  bookingHorizonDays           Int              @default(365) @map("booking_horizon_days")
  /// Future bookings one customer may hold at this business (anti-hoarding, D-037).
  maxFutureBookingsPerCustomer Int              @default(3) @map("max_future_bookings_per_customer")
  /// Cancelling less than this many hours before the start counts as a late cancel (D-035).
  cancellationWindowHours      Int              @default(12) @map("cancellation_window_hours")
  /// Earliest a booking may start, from now.
  minNoticeMinutes             Int              @default(60) @map("min_notice_minutes")
  /// Slot start times are multiples of this.
  slotStepMinutes              Int              @default(15) @map("slot_step_minutes")
  /// A customer who hasn\'t arrived this long after the start can be marked a no-show.
  noShowGraceMinutes           Int              @default(15) @map("no_show_grace_minutes")
  updatedAt                    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("booking_settings")
}

/// A member of a business's team. `userId` is set once the invite is accepted.
model Staff {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  displayName     String   @map("display_name") @db.VarChar(100)
  bio             String?
  specializations String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  services          StaffService[]
  availabilityRules AvailabilityRule[]
  exceptions        AvailabilityException[]
  appointments      Appointment[]
  photo             StaffPhoto?
  attendance        StaffAttendance[]

  @@unique([businessId, userId])
  @@unique([id, businessId])
  @@index([businessId, isActive])
  @@index([userId])
  @@map("staff")
}

model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

/// Bookable non-human capacity: a chair, a bay, a treatment room.
model Resource {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  availabilityRules AvailabilityRule[]
  exceptions        AvailabilityException[]
  appointments      Appointment[]

  @@index([businessId, isActive])
  @@map("resources")
}

/// Weekly recurring schedule (business-wide, per staff, or per resource).
/// DB extras: CHECK day 0-6, HH:MM, start < end.
model AvailabilityRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String?  @map("staff_id") @db.Uuid
  resourceId String?  @map("resource_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  startTime  String   @map("start_time") @db.VarChar(5)
  endTime    String   @map("end_time") @db.VarChar(5)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
  @@index([staffId, dayOfWeek])
  @@map("availability_rules")
}

/// One-off overrides: holidays, modified hours, extra hours.
model AvailabilityException {
  id            String        @id @default(uuid(7)) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  staffId       String?       @map("staff_id") @db.Uuid
  resourceId    String?       @map("resource_id") @db.Uuid
  exceptionDate DateTime      @map("exception_date") @db.Date
  type          ExceptionType
  startTime     String?       @map("start_time") @db.VarChar(5)
  endTime       String?       @map("end_time") @db.VarChar(5)
  reason        String?       @db.VarChar(200)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([businessId, exceptionDate])
  @@index([staffId, exceptionDate])
  @@map("availability_exceptions")
}

// ═════════════════════════════ BOOKINGS ═════════════════════════════

/// DB extras (integrity guarantees that hold even if application code regresses):
///  • EXCLUDE: a staff member cannot have two overlapping pending/confirmed appointments.
///  • EXCLUDE: a resource cannot be double-booked either.
///  • CHECK end_at > start_at, price >= 0, version >= 1, confirmation-code format.
model Appointment {
  id                String                   @id @default(uuid(7)) @db.Uuid
  businessId        String                   @map("business_id") @db.Uuid
  serviceId         String                   @map("service_id") @db.Uuid
  staffId           String?                  @map("staff_id") @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  resourceId        String?                  @map("resource_id") @db.Uuid
  status            AppointmentStatus        @default(pending)
  startAt           DateTime                 @map("start_at") @db.Timestamptz(6)
  endAt             DateTime                 @map("end_at") @db.Timestamptz(6)
  /// End plus the service's clean-up buffer: the employee is busy until then
  /// (the staff no-overlap rule uses this; the customer sees `endAt`).
  blockedUntil      DateTime                 @map("blocked_until") @db.Timestamptz(6)
  /// Customer-visible notes (sanitized).
  notes             String?
  /// Business-only notes. Never returned to the customer.
  internalNotes     String?                  @map("internal_notes")
  price             Decimal                  @db.Decimal(10, 2)
  currency          String                   @db.Char(3)
  paymentStatus     AppointmentPaymentStatus @default(unpaid) @map("payment_status")
  /// Optimistic concurrency: every update must match and increment this.
  version           Int                      @default(1)
  confirmationCode  String                   @unique @map("confirmation_code") @db.VarChar(20)
  reminder24hSentAt DateTime?                @map("reminder_24h_sent_at") @db.Timestamptz(6)
  reminder2hSentAt  DateTime?                @map("reminder_2h_sent_at") @db.Timestamptz(6)
  cancelledAt       DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  /// Free-text note with a cancellation.
  cancelReason      String?                  @map("cancel_reason")
  /// Why it was cancelled (feeds the business's cancellation chart, D-035).
  cancelReasonCode  CancelReasonCode?        @map("cancel_reason_code")
  /// Cancelled by the customer inside the business's cancellation window (reliability, D-035).
  lateCancellation  Boolean                  @default(false) @map("late_cancellation")
  /// "I'll book later": remind the customer around this time (notifications, 2.6).
  rebookReminderAt  DateTime?                @map("rebook_reminder_at") @db.Timestamptz(6)
  /// The customer arrived (receipt scanned, code typed, or picked from the list).
  /// Status stays `confirmed`, so the no-overlap rules keep applying during the visit.
  checkedInAt       DateTime?                @map("checked_in_at") @db.Timestamptz(6)
  checkedInById     String?                  @map("checked_in_by_id") @db.Uuid
  cancelledBy       ActorType?               @map("cancelled_by")
  rescheduledFromId String?                  @unique @map("rescheduled_from_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service         Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff           Staff?                     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  user            User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  resource        Resource?                  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?               @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment?               @relation("Reschedule")
  checkedInBy     User?                      @relation("AppointmentCheckIn", fields: [checkedInById], references: [id], onDelete: SetNull)
  statusHistory   AppointmentStatusHistory[]
  payment         Payment?
  review          Review?

  @@index([businessId, startAt])
  @@index([userId, startAt])
  @@index([staffId, startAt])
  @@index([status, startAt])
  @@index([createdAt])
  @@map("appointments")
}

/// Append-only log of every status change; powers GET /appointments/:id/timeline.
model AppointmentStatusHistory {
  id            String             @id @default(uuid(7)) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  actorType     ActorType          @map("actor_type")
  actorId       String?            @map("actor_id") @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

/// Appointment payments (deposits). NOTE: Paddle is a merchant of record for
/// BUKU's own sales (subscriptions, ads); it cannot pay out to third-party
/// businesses. Customer→business payments need a marketplace processor before
/// this table is used in production (see docs/BUILD_GUIDE.md, open questions).
model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  appointmentId         String        @unique @map("appointment_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  businessId            String        @map("business_id") @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @db.Char(3)
  platformFee           Decimal       @default(0) @map("platform_fee") @db.Decimal(10, 2)
  status                PaymentStatus @default(pending)
  method                String?       @db.VarChar(30)
  providerTransactionId String?       @unique @map("provider_transaction_id") @db.VarChar(200)
  refundId              String?       @map("refund_id") @db.VarChar(200)
  capturedAt            DateTime?     @map("captured_at") @db.Timestamptz(6)
  refundedAt            DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@map("payments")
}

/// One review per completed appointment. DB extras: CHECK ratings 1..5; trigger keeps
/// businesses.avg_rating / review_count in sync.
model Review {
  id                String    @id @default(uuid(7)) @db.Uuid
  appointmentId     String    @unique @map("appointment_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  overallRating     Int       @map("overall_rating") @db.SmallInt
  waitTimeRating    Int?      @map("wait_time_rating") @db.SmallInt
  staffRating       Int?      @map("staff_rating") @db.SmallInt
  cleanlinessRating Int?      @map("cleanliness_rating") @db.SmallInt
  valueRating       Int?      @map("value_rating") @db.SmallInt
  comment           String?
  ownerResponse     String?   @map("owner_response")
  ownerRespondedAt  DateTime? @map("owner_responded_at") @db.Timestamptz(6)
  isFlagged         Boolean   @default(false) @map("is_flagged")
  flagReason        String?   @map("flag_reason") @db.VarChar(200)
  isVisible         Boolean   @default(true) @map("is_visible")
  /// The customer changed it (allowed for 7 days after posting).
  editedAt          DateTime? @map("edited_at") @db.Timestamptz(6)
  /// Reported by the business (who and when); an admin decides whether to hide it.
  flaggedAt         DateTime? @map("flagged_at") @db.Timestamptz(6)
  flaggedById       String?   @map("flagged_by_id") @db.Uuid
  /// Hidden by an admin (stays stored; the business's rating no longer counts it).
  hiddenAt          DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenReason      String?   @map("hidden_reason") @db.VarChar(300)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isVisible, createdAt])
  @@index([businessId, overallRating])
  @@index([isFlagged, flaggedAt])
  @@index([userId])
  @@map("reviews")
}

model Favourite {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("favourites")
}

/// Know-your-business (KYB) details: who is legally behind a business. Country-flexible:
/// the registration TYPE is free text per country (e.g. PK "NTN", GB "Companies House").
/// Identifiers and the responsible person's contact details are ENCRYPTED; the keyed hash of
/// the registration number lets admins spot one registration used by different owners.
model BusinessLegalProfile {
  businessId                  String   @id @map("business_id") @db.Uuid
  legalName                   String   @map("legal_name") @db.VarChar(300)
  registrationCountry         String   @map("registration_country") @db.Char(2)
  registrationType            String   @map("registration_type") @db.VarChar(100)
  registrationNumberEncrypted String   @map("registration_number_encrypted")
  registrationNumberHash      String   @map("registration_number_hash") @db.Char(64)
  taxIdEncrypted              String?  @map("tax_id_encrypted")
  registeredAddress           String   @map("registered_address")
  responsibleName             String   @map("responsible_name") @db.VarChar(200)
  responsibleRole             String   @map("responsible_role") @db.VarChar(100)
  responsibleEmailEncrypted   String?  @map("responsible_email_encrypted")
  responsiblePhoneEncrypted   String?  @map("responsible_phone_encrypted")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([registrationNumberHash])
  @@index([registrationCountry])
  @@map("business_legal_profiles")
}

/// Access to a business for someone other than its owner (owner = businesses.owner_id).
/// Owned by auth-service (identity & access); every service reads it for authorization
/// through `businessRoleOf()` in @buku/database.
model BusinessMember {
  id          String               @id @default(uuid(7)) @db.Uuid
  businessId  String               @map("business_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  role        BusinessMemberRole
  status      BusinessMemberStatus @default(active)
  createdById String?              @map("created_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User     @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@map("business_members")
}

/// "Report this business" (important because unverified businesses can take bookings, D-032).
/// One report per person per business.
model BusinessReport {
  id           String               @id @default(uuid(7)) @db.Uuid
  businessId   String               @map("business_id") @db.Uuid
  reporterId   String?              @map("reporter_id") @db.Uuid
  reason       BusinessReportReason
  details      String?
  status       BusinessReportStatus @default(open)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reporter   User?    @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([businessId, reporterId])
  @@index([status, createdAt])
  @@map("business_reports")
}

// ═════════════════════════════ QUEUES ═════════════════════════════

/// One queue per business per day. Live state lives in Valkey; this is the durable record.
/// DB extras: CHECK counters >= 0, max_queue_size > 0.
model QueueSession {
  id                 String             @id @default(uuid(7)) @db.Uuid
  businessId         String             @map("business_id") @db.Uuid
  sessionDate        DateTime           @map("session_date") @db.Date
  status             QueueSessionStatus @default(open)
  ticketPrefix       String             @default("A") @map("ticket_prefix") @db.VarChar(5)
  currentNumber      Int                @default(0) @map("current_number")
  lastCalledNumber   Int                @default(0) @map("last_called_number")
  totalServed        Int                @default(0) @map("total_served")
  avgServiceSeconds  Int                @default(300) @map("avg_service_seconds")
  maxQueueSize       Int                @default(200) @map("max_queue_size")
  gracePeriodSeconds Int                @default(300) @map("grace_period_seconds")
  openedAt           DateTime?          @map("opened_at") @db.Timestamptz(6)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries  QueueEntry[]

  @@unique([businessId, sessionDate])
  @@index([status, sessionDate])
  @@map("queue_sessions")
}

/// How a business runs its queue (owned by queue-service). No row → the defaults below.
model QueueSettings {
  businessId             String   @id @map("business_id") @db.Uuid
  /// Remote joins only within this distance of the business (D-038).
  remoteJoinRadiusMeters Int      @default(5000) @map("remote_join_radius_meters")
  maxQueueSize           Int      @default(200) @map("max_queue_size")
  /// A called customer who doesn't come within this long can be marked a no-show (decision H).
  gracePeriodSeconds     Int      @default(300) @map("grace_period_seconds")
  ticketPrefix           String   @default("A") @map("ticket_prefix") @db.VarChar(3)
  /// Starting estimate of one service; replaced by the day's real average once people are served.
  avgServiceSeconds      Int      @default(300) @map("avg_service_seconds")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("queue_settings")
}

/// DB extras: partial UNIQUE (user_id) while waiting/called/serving, so a customer holds
/// at most ONE live ticket in any queue anywhere (D-038).
model QueueEntry {
  id                   String           @id @default(uuid(7)) @db.Uuid
  sessionId            String           @map("session_id") @db.Uuid
  /// Null for walk-ins added by staff.
  userId               String?          @map("user_id") @db.Uuid
  ticketNumber         Int              @map("ticket_number")
  ticketPrefix         String           @default("A") @map("ticket_prefix") @db.VarChar(5)
  status               QueueEntryStatus @default(waiting)
  estimatedWaitSeconds Int?             @map("estimated_wait_seconds")
  /// Elderly / disabled priority lane.
  priorityLane         Boolean          @default(false) @map("priority_lane")
  notes                String?          @db.VarChar(500)
  joinedAt             DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  calledAt             DateTime?        @map("called_at") @db.Timestamptz(6)
  servedAt             DateTime?        @map("served_at") @db.Timestamptz(6)
  completedAt          DateTime?        @map("completed_at") @db.Timestamptz(6)
  leftAt               DateTime?        @map("left_at") @db.Timestamptz(6)
  actualServiceSeconds Int?             @map("actual_service_seconds")
  /// Joined from their phone (within the distance limit) rather than at the counter.
  joinedRemotely       Boolean          @default(false) @map("joined_remotely")
  /// Walk-ins added by the front desk: an optional name to call out (no account).
  walkInName           String?          @map("walk_in_name") @db.VarChar(100)
  /// Last "people ahead of you" count we alerted about (10, 5, then every step), so each alert goes once.
  lastAlertedAhead     Int?             @map("last_alerted_ahead")

  session QueueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([sessionId, ticketNumber])
  @@index([sessionId, status])
  @@index([userId, joinedAt])
  @@map("queue_entries")
}

// ═══════════════════════ NOTIFICATIONS (partitioned) ═══════════════════════

/// Range-partitioned monthly by created_at (see migration); hence the composite key.
model Notification {
  id              String              @default(uuid(7)) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  appointmentId   String?             @map("appointment_id") @db.Uuid
  queueEntryId    String?             @map("queue_entry_id") @db.Uuid
  type            String              @db.VarChar(50)
  channel         NotificationChannel
  title           String              @db.VarChar(200)
  body            String
  /// Deep-link payload for the app (screen + ids). No secrets, no PII.
  data            Json?
  status          NotificationStatus  @default(pending)
  externalId      String?             @map("external_id") @db.VarChar(500)
  /// The device a push went to (to switch it off if the push service says it no longer exists).
  pushTokenId     String?             @map("push_token_id") @db.Uuid
  /// WhatsApp only: `window` (free-form reply inside the customer's 24-hour window) or
  /// `template` (paid template outside it). Counts the month's estimated spend (D-073).
  whatsappPricing String?             @map("whatsapp_pricing") @db.VarChar(20)
  failureReason   String?             @map("failure_reason")
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt     DateTime?           @map("delivered_at") @db.Timestamptz(6)
  readAt          DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([status, createdAt])
  @@map("notifications")
}

// ═════════════════════════════ ADS ═════════════════════════════

/// DB extras: CHECK budgets/counters >= 0, end_date > start_date.
/// How notifications go out, editable by admins at any time (one row, id = 1; D-073).
model NotificationSettings {
  id                         Int      @id @default(1) @db.SmallInt
  /// Master switch for email (booking receipts, reminders, billing notices).
  emailEnabled               Boolean  @default(true) @map("email_enabled")
  /// Master switch for WhatsApp. Off: nothing goes by WhatsApp, linking still works.
  whatsappEnabled            Boolean  @default(false) @map("whatsapp_enabled")
  /// Message types that may go as PAID templates when the person's free 24-hour window is closed.
  whatsappPaidTypes          String[] @default([]) @map("whatsapp_paid_types") @db.VarChar(50)
  /// Cap on the month's estimated WhatsApp spend, in US cents. 0 = never pay for a message.
  whatsappMonthlyBudgetCents Int      @default(0) @map("whatsapp_monthly_budget_cents")
  /// Estimated price of one paid WhatsApp message, in US cents (Meta's rate card for your market).
  whatsappMessageCostCents   Decimal  @default(4) @map("whatsapp_message_cost_cents") @db.Decimal(8, 4)
  /// Replies inside the 24-hour window that Meta does not charge for, per month.
  whatsappFreeWindowPerMonth Int      @default(1000) @map("whatsapp_free_window_per_month")
  reminder24h                Boolean  @default(true) @map("reminder_24h")
  reminder2h                 Boolean  @default(true) @map("reminder_2h")
  /// Night time (local hours): reminders and suggestions wait until it ends.
  quietStartHour             Int      @default(21) @map("quiet_start_hour") @db.SmallInt
  quietEndHour               Int      @default(9) @map("quiet_end_hour") @db.SmallInt
  /// Suggestions based on usage (people who opted in only).
  suggestionsEnabled         Boolean  @default(true) @map("suggestions_enabled")
  /// At least this many days between two suggestions to the same person.
  suggestionMinDays          Int      @default(7) @map("suggestion_min_days") @db.SmallInt
  /// At most this many suggestions to one person in 30 days.
  suggestionMaxPer30Days     Int      @default(3) @map("suggestion_max_per_30_days") @db.SmallInt
  /// Stop after this many suggestions with no booking in between (they're not interested).
  suggestionMaxIgnored       Int      @default(3) @map("suggestion_max_ignored") @db.SmallInt
  updatedById                String?  @map("updated_by_id") @db.Uuid
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_settings")
}

/// A WhatsApp number the person proved is theirs by messaging BUKU a one-time code (D-074).
model WhatsappContact {
  userId         String    @id @map("user_id") @db.Uuid
  /// AES-256-GCM ciphertext, context "whatsapp.phone" (E.164).
  phoneEncrypted String    @map("phone_encrypted")
  phoneHash      String    @unique @map("phone_hash") @db.Char(64)
  linkedAt       DateTime  @map("linked_at") @db.Timestamptz(6)
  /// Their last message to us: replies are free for 24 hours after it.
  lastInboundAt  DateTime? @map("last_inbound_at") @db.Timestamptz(6)
  /// They replied STOP: nothing more by WhatsApp until START.
  optedOutAt     DateTime? @map("opted_out_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_contacts")
}

/// Scheduled messages already sent (e.g. "appt:<id>:r24"): each goes once, even with
/// several notification-service instances; also counts suggestions for frequency caps.
model NotificationMark {
  key       String   @id @db.VarChar(200)
  userId    String?  @map("user_id") @db.Uuid
  kind      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@map("notification_marks")
}

model BusinessAd {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  type              AdType
  categoryId        String?   @map("category_id") @db.Uuid
  city              String?   @db.VarChar(100)
  country           String?   @db.VarChar(100)
  status            AdStatus  @default(draft)
  startDate         DateTime  @map("start_date") @db.Timestamptz(6)
  endDate           DateTime  @map("end_date") @db.Timestamptz(6)
  weeklyBudget      Decimal?  @map("weekly_budget") @db.Decimal(10, 2)
  totalBudget       Decimal   @map("total_budget") @db.Decimal(10, 2)
  amountSpent       Decimal   @default(0) @map("amount_spent") @db.Decimal(10, 2)
  impressions       Int       @default(0)
  clicks            Int       @default(0)
  bookings          Int       @default(0)
  revenueAttributed Decimal   @default(0) @map("revenue_attributed") @db.Decimal(10, 2)
  rejectionReason   String?   @map("rejection_reason")
  paymentMethod     String?   @map("payment_method") @db.VarChar(30)
  paymentRef        String?   @map("payment_ref") @db.VarChar(200)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  events   AdEvent[]

  @@index([businessId, status])
  @@index([status, startDate, endDate])
  @@index([type, city, country, status])
  @@map("business_ads")
}

/// Range-partitioned monthly by created_at. `ipHash` is a keyed hash, never a raw IP.
model AdEvent {
  id         String      @default(uuid(7)) @db.Uuid
  adId       String      @map("ad_id") @db.Uuid
  businessId String      @map("business_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  type       AdEventType
  sessionId  String?     @map("session_id") @db.VarChar(100)
  ipHash     String?     @map("ip_hash") @db.Char(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  ad       BusinessAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([adId, type, createdAt])
  @@index([businessId, type, createdAt])
  @@index([userId, type, createdAt])
  @@map("ad_events")
}

// ═════════════════════════════ AI RECEPTIONIST ═════════════════════════════

model AiReceptionistConfig {
  id                String   @id @default(uuid(7)) @db.Uuid
  businessId        String   @unique @map("business_id") @db.Uuid
  isEnabled         Boolean  @default(false) @map("is_enabled")
  phoneNumber       String?  @map("phone_number") @db.VarChar(20)
  voiceId           String?  @map("voice_id") @db.VarChar(100)
  greetingMessage   String?  @map("greeting_message")
  /// Short always-present summary; detailed knowledge lives in ai.business_knowledge_chunks (raw SQL, pgvector).
  businessContext   String?  @map("business_context")
  /// [{ type: "staff_leave", staffId, reason, until }]
  activeOverrides   Json     @default("[]") @map("active_overrides")
  totalCallsHandled Int      @default(0) @map("total_calls_handled")
  totalBookingsMade Int      @default(0) @map("total_bookings_made")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("ai_receptionist_configs")
}

model AiCallLog {
  id                   String        @id @default(uuid(7)) @db.Uuid
  businessId           String        @map("business_id") @db.Uuid
  /// Encrypted (context "ai_call_logs.caller_phone").
  callerPhoneEncrypted String?       @map("caller_phone_encrypted")
  durationSeconds      Int?          @map("duration_seconds")
  transcriptUrl        String?       @map("transcript_url")
  appointmentId        String?       @map("appointment_id") @db.Uuid
  outcome              AiCallOutcome
  failureReason        String?       @map("failure_reason")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("ai_call_logs")
}

// ═════════════════════════════ INTEGRATIONS ═════════════════════════════

/// Outgoing webhooks. The signing secret must be recoverable (to sign), so it is
/// ENCRYPTED (context "webhooks.secret"), not hashed.
model Webhook {
  id              String    @id @default(uuid(7)) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  url             String
  secretEncrypted String    @map("secret_encrypted")
  events          String[]
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz(6)
  failureCount    Int       @default(0) @map("failure_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([businessId, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  webhookId      String    @map("webhook_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(100)
  payload        Json
  responseStatus Int?      @map("response_status")
  /// Truncated to 2 KB by the dispatcher.
  responseBody   String?   @map("response_body")
  attemptCount   Int       @default(1) @map("attempt_count")
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  nextRetryAt    DateTime? @map("next_retry_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([webhookId, createdAt])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

// ═════════════════════════════ BILLING (billing-service) ═════════════════════════════
// Everything here is DATA edited by platform admins at any time (D-065): plans, prices,
// limits, benefits, the on/off switch per audience, costs and fees.

/// A plan users or businesses can be on.
model Plan {
  id                String       @id @default(uuid(7)) @db.Uuid
  /// Stable identifier used by code and admins, e.g. "user_plus", "business_local".
  code              String       @unique @db.VarChar(50)
  audience          PlanAudience
  name              String       @db.VarChar(100)
  tagline           String?      @db.VarChar(200)
  /// Pricing-page bullet points, in order (string[]).
  benefits          Json         @default("[]")
  /// { limitKey: number | null } — null or a missing key means unlimited.
  limits            Json         @default("{}")
  /// { featureKey: boolean } — a missing key means off.
  features          Json         @default("{}")
  /// Shown on the pricing page and can be bought (internal plans like "unlimited" are not).
  isPublic          Boolean      @default(true) @map("is_public")
  sortOrder         Int          @default(0) @map("sort_order")
  /// Archived: hidden and can't be bought; current subscribers keep it until moved.
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)
  /// The plan as a product in Paddle (created when a price is first synced there).
  externalProductId String?      @unique @map("external_product_id") @db.VarChar(200)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices          PlanPrice[]
  subscriptions   Subscription[]
  defaultFor      BillingSettings[] @relation("DefaultPlan")
  whenDisabledFor BillingSettings[] @relation("PlanWhenDisabled")
  trialFor        BillingSettings[] @relation("TrialPlan")
  requests        PlanRequest[]

  @@index([audience, archivedAt])
  @@map("plans")
}

/// What a plan costs on one channel, in one currency. Never edited: a new price replaces it
/// (the old one is archived), so subscribers keep the price they agreed to until moved.
model PlanPrice {
  id              String          @id @default(uuid(7)) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  channel         BillingChannel
  currency        String          @db.Char(3)
  amount          Decimal         @db.Decimal(10, 2)
  interval        BillingInterval @default(month)
  /// The amount already includes sales tax / VAT (otherwise tax is added at checkout).
  taxInclusive    Boolean         @default(false) @map("tax_inclusive")
  trialDays       Int             @default(0) @map("trial_days")
  /// The store's id for this price (Paddle price, Play product, App Store product), once set up.
  externalPriceId String?         @unique @map("external_price_id") @db.VarChar(200)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([planId, archivedAt])
  @@map("plan_prices")
}

/// Billing per audience. Switched off → everyone gets `planWhenDisabled` and nothing breaks.
model BillingSettings {
  audience           PlanAudience @id
  /// Charging is on for this audience.
  enabled            Boolean      @default(false)
  /// Plan for accounts without an active subscription (e.g. Free).
  defaultPlanId      String       @map("default_plan_id") @db.Uuid
  /// Plan everyone gets while billing is off (normally an unlimited internal plan).
  planWhenDisabledId String       @map("plan_when_disabled_id") @db.Uuid
  /// A free trial each account can start once, whenever it likes (switch off → no new trials).
  trialEnabled       Boolean      @default(true) @map("trial_enabled")
  trialDays          Int          @default(30) @map("trial_days")
  /// The plan a trial gives (null → no trials).
  trialPlanId        String?      @map("trial_plan_id") @db.Uuid
  updatedById        String?      @map("updated_by_id") @db.Uuid
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultPlan      Plan  @relation("DefaultPlan", fields: [defaultPlanId], references: [id], onDelete: Restrict)
  planWhenDisabled Plan  @relation("PlanWhenDisabled", fields: [planWhenDisabledId], references: [id], onDelete: Restrict)
  trialPlan        Plan? @relation("TrialPlan", fields: [trialPlanId], references: [id], onDelete: Restrict)

  @@map("billing_settings")
}

/// A user's or a business's subscription — bought in a store, or granted by an admin.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  /// The price being paid (null for admin grants).
  priceId                String?            @map("price_id") @db.Uuid
  /// Exactly one of userId / businessId (database rule).
  userId                 String?            @map("user_id") @db.Uuid
  businessId             String?            @map("business_id") @db.Uuid
  channel                BillingChannel?
  /// paddle | google_play | app_store | manual (admin grant) | trial (free trial, once per account)
  provider               String             @db.VarChar(20)
  externalSubscriptionId String?            @unique @map("external_subscription_id") @db.VarChar(200)
  externalCustomerId     String?            @map("external_customer_id") @db.VarChar(200)
  /// When the store last changed this subscription (as the store reported it). Store events can
  /// arrive out of order: an older change than this one is ignored.
  providerUpdatedAt      DateTime?          @map("provider_updated_at") @db.Timestamptz(6)
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(6)
  /// Paid (or granted) until. Null for an open-ended grant.
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  grantedById            String?            @map("granted_by_id") @db.Uuid
  grantNote              String?            @map("grant_note") @db.VarChar(300)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  price       PlanPrice?   @relation(fields: [priceId], references: [id], onDelete: Restrict)
  user        User?        @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Restrict)
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  grantedBy   User?        @relation("SubscriptionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  planRequest PlanRequest?

  @@index([userId, status])
  @@index([businessId, status])
  @@index([planId, status])
  @@map("subscriptions")
}

/// A business asking for a plan — e.g. a large organisation asking for Enterprise free of
/// charge. Platform admins approve (→ a grant) or decline. One open request per business.
model PlanRequest {
  id             String            @id @default(uuid(7)) @db.Uuid
  businessId     String            @map("business_id") @db.Uuid
  planId         String            @map("plan_id") @db.Uuid
  requestedById  String            @map("requested_by_id") @db.Uuid
  message        String            @db.VarChar(1000)
  status         PlanRequestStatus @default(pending)
  decidedById    String?           @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?         @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?           @map("decision_note") @db.VarChar(500)
  /// The grant created when approved.
  subscriptionId String?           @unique @map("subscription_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  requestedBy  User          @relation("PlanRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy    User?         @relation("PlanRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessId, createdAt])
  @@map("plan_requests")
}

/// What running BUKU costs per month (servers, database, messaging…): for the profit calculator.
model BillingCostItem {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String    @db.VarChar(100)
  /// infrastructure | messaging | software | other
  category      String    @db.VarChar(30)
  monthlyAmount Decimal   @map("monthly_amount") @db.Decimal(12, 2)
  /// Costs are kept in USD, the currency of the plans' main prices.
  currency      String    @default("USD") @db.Char(3)
  notes         String?   @db.VarChar(300)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_cost_items")
}

/// What each sales channel keeps per payment (Paddle %+fixed, store commissions).
model BillingChannelFee {
  channel     BillingChannel @id
  percent     Decimal        @db.Decimal(5, 2)
  fixedAmount Decimal        @default(0) @map("fixed_amount") @db.Decimal(10, 2)
  currency    String         @default("USD") @db.Char(3)
  notes       String?        @db.VarChar(300)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_channel_fees")
}

// ═════════════════════════════ PLATFORM ═════════════════════════════

/// Security/compliance trail. Range-partitioned monthly by created_at.
/// Old/new values must be redacted of secrets and PII by the writer.
model AuditLog {
  id           String   @default(uuid(7)) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  requestId    String?  @map("request_id") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([id, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Transactional outbox (docs/ARCHITECTURE.md). A service writes its business row AND an
/// event row in ONE transaction; a relay publishes unpublished rows to Kafka. No lost events.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  /// Kafka topic, e.g. "bookings.created".
  topic         String    @db.VarChar(100)
  /// Kafka message key (per-aggregate ordering).
  partitionKey  String    @map("partition_key") @db.VarChar(100)
  /// The full event envelope as it will be published.
  payload       Json
  headers       Json?
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Idempotency ledger ("inbox"). Kafka and Paddle both deliver AT LEAST once; a consumer
/// inserts (consumer, event_id) in the same transaction as its side effect and skips
/// the event if the row already exists.
model ProcessedEvent {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.VarChar(200)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}
