// ═══════════════════════════════════════════════════════════════════════════
// BUKU — PostgreSQL 17 schema (PostGIS + pgvector)
//
// Conventions
//  • Primary keys are UUIDv7 (time-ordered: new rows land at the end of the
//    B-tree index instead of random pages → much better insert performance
//    than UUIDv4, and still safe to expose / shard later).
//  • Every timestamp is TIMESTAMPTZ(6). Wall-clock business hours are
//    "HH:MM" strings interpreted in the business's `timezone`.
//  • Money is DECIMAL(10,2) + ISO 4217 currency.
//  • Users' email/phone are stored ENCRYPTED (AES-256-GCM) with a keyed
//    blind-index hash for lookups and uniqueness (see docs/DECISIONS.md).
//  • Things Prisma cannot express (CHECK constraints, exclusion constraints,
//    generated columns, partitioning, triggers) live in the hand-written part
//    of the migrations and are listed in comments next to the model.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

