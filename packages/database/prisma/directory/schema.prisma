// ═══════════════════════════════════════════════════════════════════════════
// BUKU — the DIRECTORY database (docs/DATABASE.md §6, DB-011…DB-013)
//
// One per deployment (its own cluster in production), read by every service:
//  • registry.*  where every person and business lives: regions, physical clusters, the shard
//                families ("entities"), and the shards with their ID ranges and row limits;
//                ID generator leases; a log of every change; a version routers watch.
//  • ids.*       the database's own ID generator (the same 64-bit layout as @buku/common's).
//  • reference.* reference data (DB-015): currencies, kinds of business, plans and prices, billing
//                and notification settings. The source of truth, published to every business shard
//                and the catalog, which keep read-only copies (logical replication).
//  • lookup.*    global handles (DB-018): what a person or business is found by before its shard
//                is known (an email's blind index, a Google account, a slug, a public ID), each
//                unique across every shard.
//
// Everything that may need to change as BUKU grows is a row, not code: add a region, a cluster, a
// shard family or a shard; change a limit. Statuses are text with CHECK constraints (not enums),
// so a new status needs no type migration. The one thing fixed for good is the ID layout and its
// epoch (DB-002): changing them would break the order of every ID already made.
//
// Constraints, functions and triggers Prisma can't express are in the migration SQL.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/directory"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["registry", "ids", "lookup", "reference"]
}

/// A region data can be kept in (DB-002: the top 3 bits of an ID's generator say which).
model Region {
  /// 0..7, the code inside IDs.
  region           Int      @id @db.SmallInt
  /// 'pk', 'eu', … (lower case letters).
  code             String   @unique @db.VarChar(16)
  name             String   @db.VarChar(100)
  active           Boolean  @default(true)
  /// Where new shards in this region are created by default.
  defaultClusterId Int?     @map("default_cluster_id") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultCluster Cluster?  @relation("RegionDefaultCluster", fields: [defaultClusterId], references: [clusterId])
  clusters       Cluster[] @relation("ClusterRegion")
  shards         Shard[]

  @@map("regions")
  @@schema("registry")
}

/// A shard family: what is placed by ID range (people, businesses, and any later family).
model Entity {
  entity          String   @id @db.VarChar(32)
  description     String
  /// Rows per shard for new shards (changeable at any time; DB-011).
  defaultRowLimit BigInt   @map("default_row_limit")
  /// How a new shard's database is named: {entity}, {region} (code) and {shard} are filled in.
  databasePattern String   @map("database_pattern") @db.VarChar(100)
  /// Database roles allowed to place new rows of this family (checked by registry.place()).
  placedBy        String[] @default([]) @map("placed_by")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shards Shard[]

  @@map("entities")
  @@schema("registry")
}

/// A physical PostgreSQL cluster (primary + standbys) that hosts logical shards (DB-012).
model Cluster {
  clusterId Int      @id @map("cluster_id") @db.SmallInt
  region    Int      @db.SmallInt
  name      String   @unique @db.VarChar(64)
  /// The NAME of the secret holding the connection string, never the string itself.
  dsnSecret String   @map("dsn_secret") @db.VarChar(128)
  /// active | draining | retired
  status    String   @default("active") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  regionRow       Region   @relation("ClusterRegion", fields: [region], references: [region])
  defaultInRegion Region[] @relation("RegionDefaultCluster")
  shards          Shard[]

  @@map("clusters")
  @@schema("registry")
}

/// A logical shard: one database on a cluster, holding one range of a family's IDs (DB-011, DB-013).
model Shard {
  entity       String    @db.VarChar(32)
  region       Int       @db.SmallInt
  shardNo      Int       @map("shard_no")
  /// First ID in this shard; NULL while it waits to be opened ('ready').
  minId        BigInt?   @map("min_id")
  /// Last ID in this shard; NULL until it fills.
  maxId        BigInt?   @map("max_id")
  /// The highest ID placed so far: the shard closes exactly here, and every ID up to it is known to
  /// be in this shard (routers trust their cached copy up to it).
  lastId       BigInt?   @map("last_id")
  rowLimit     BigInt    @map("row_limit")
  rowCount     BigInt    @default(0) @map("row_count")
  /// ready | open | full | read_only | moving | retired
  status       String    @db.VarChar(16)
  clusterId    Int       @map("cluster_id") @db.SmallInt
  databaseName String    @map("database_name") @db.VarChar(63)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  openedAt     DateTime? @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)

  entityRow Entity  @relation(fields: [entity], references: [entity])
  regionRow Region  @relation(fields: [region], references: [region])
  cluster   Cluster @relation(fields: [clusterId], references: [clusterId])

  @@id([entity, region, shardNo])
  @@index([clusterId])
  @@index([region])
  @@map("shards")
  @@schema("registry")
}

/// One of the 1,024 ID generators (DB-002), leased by a running service instance at a time.
model IdGenerator {
  generatorId  Int       @id @map("generator_id") @db.SmallInt
  /// service (leased by running instances) | database (set on a database for its own inserts)
  purpose      String    @db.VarChar(16)
  leasedBy     String?   @map("leased_by") @db.VarChar(200)
  leaseExpires DateTime? @map("lease_expires") @db.Timestamptz(6)

  @@index([purpose, leaseExpires])
  @@map("id_generators")
  @@schema("registry")
}

/// Every change to regions, clusters, families and shards (limits, status, placement), by whom.
model Change {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(6)
  /// The database role that made it, and the application's name for who asked (when set).
  dbRole    String   @map("db_role") @db.VarChar(63)
  actor     String?  @db.VarChar(200)
  tableName String   @map("table_name") @db.VarChar(63)
  operation String   @db.VarChar(8)
  oldRow    Json?    @map("old_row")
  newRow    Json?    @map("new_row")

  @@index([at])
  @@map("changes")
  @@schema("registry")
}

/// A number that goes up whenever the registry's layout changes; routers re-read when it does.
model Version {
  id        Int      @id @default(1) @db.SmallInt
  version   BigInt   @default(1)
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@map("version")
  @@schema("registry")
}

/// When a full shard had no 'ready' shard to hand over to (it keeps taking rows past its limit).
model Alert {
  id         BigInt    @id @default(autoincrement())
  at         DateTime  @default(now()) @db.Timestamptz(6)
  kind       String    @db.VarChar(32)
  entity     String    @db.VarChar(32)
  region     Int       @db.SmallInt
  shardNo    Int       @map("shard_no")
  detail     String
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([resolvedAt])
  @@map("alerts")
  @@schema("registry")
}

/// The database's own ID generator state: the last millisecond and sequence per generator.
model IdState {
  generatorId Int    @id @map("generator_id") @db.SmallInt
  lastMs      BigInt @map("last_ms")
  lastSeq     Int    @map("last_seq")

  @@map("state")
  @@schema("ids")
}

/// A kind of handle (DB-018): what it identifies, how long its key is, and who may write it.
model HandleKind {
  kind        Int      @id @db.SmallInt
  /// 'user.email', 'business.slug', … (lower case, family first).
  name        String   @unique @db.VarChar(40)
  /// The shard family its owners belong to.
  entity      String   @db.VarChar(32)
  /// Key length in bytes (a blind index is 16; a public ID 12).
  keyMin      Int      @map("key_min") @db.SmallInt
  keyMax      Int      @map("key_max") @db.SmallInt
  /// Database roles allowed to claim and release handles of this kind.
  writers     String[] @default([])
  description String
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  handles Handle[]

  @@map("handle_kinds")
  @@schema("lookup")
}

/// One handle: a key of a kind, and the person or business it belongs to (hash-partitioned by key).
model Handle {
  ownerId   BigInt   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  kind      Int      @db.SmallInt
  key       Bytes

  kindRow HandleKind @relation(fields: [kind], references: [kind])

  @@id([kind, key])
  @@index([ownerId])
  @@map("handles")
  @@schema("lookup")
}

// ═════════════════════════════ REFERENCE DATA (DB-015) ═════════════════════════════
// Published as `buku_reference`; the copies are prisma/business and prisma/catalog's `reference`
// models, which must keep the same columns (a test compares them).

/// An ISO 4217 currency and its minor unit: amounts are stored × 10^exponent (DB-009).
model Currency {
  code     String  @id @db.Char(3)
  exponent Int     @db.SmallInt
  active   Boolean @default(true)
  name     String  @db.VarChar(60)

  prices PlanPrice[]

  @@map("currencies")
  @@schema("reference")
}

/// A kind of business, in a two-level tree (groups, then kinds; D-100). Owners can suggest one
/// (D-098): usable at once, kept out of public lists until reviewed.
model Category {
  id            BigInt   @id
  parentId      BigInt?  @map("parent_id")
  /// Who suggested it; null for BUKU's own.
  suggestedById BigInt?  @map("suggested_by_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  depth         Int      @default(0) @db.SmallInt
  sortOrder     Int      @default(0) @map("sort_order") @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  pending       Boolean  @default(false)
  slug          String   @unique @db.VarChar(100)
  name          String   @db.VarChar(100)
  /// The name reduced to what it means: one category per meaning (D-098).
  nameKey       String?  @unique @map("name_key") @db.VarChar(120)
  icon          String?  @db.VarChar(10)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  @@index([parentId])
  @@map("categories")
  @@schema("reference")
}

/// A plan people or businesses can be on (D-065): data admins edit at any time.
model Plan {
  id                BigInt    @id
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Archived: hidden and can't be bought; subscribers keep it until moved.
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  sortOrder         Int       @default(0) @map("sort_order") @db.SmallInt
  isPublic          Boolean   @default(true) @map("is_public")
  /// Stable identifier used by code and admins ("business_essential").
  code              String    @unique @db.VarChar(50)
  /// user | business
  audience          String    @db.VarChar(10)
  name              String    @db.VarChar(100)
  tagline           String?   @db.VarChar(200)
  /// Pricing-page bullet points, in order.
  benefits          Json      @default("[]")
  /// { limitKey: number | null }: null or missing means unlimited.
  limits            Json      @default("{}")
  /// { featureKey: boolean }: missing means off.
  features          Json      @default("{}")
  externalProductId String?   @unique @map("external_product_id") @db.VarChar(200)

  prices          PlanPrice[]
  defaultFor      BillingSettings[] @relation("DefaultPlan")
  whenDisabledFor BillingSettings[] @relation("PlanWhenDisabled")
  trialFor        BillingSettings[] @relation("TrialPlan")

  @@index([audience, archivedAt])
  @@map("plans")
  @@schema("reference")
}

/// A plan's price on one channel, in the currency's minor unit.
model PlanPrice {
  id              BigInt    @id
  planId          BigInt    @map("plan_id")
  amountMinor     BigInt    @map("amount_minor")
  createdById     BigInt?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  trialDays       Int       @default(0) @map("trial_days") @db.SmallInt
  /// The amount already includes sales tax or VAT.
  taxInclusive    Boolean   @default(false) @map("tax_inclusive")
  /// web | android | ios
  channel         String    @db.VarChar(10)
  currency        String    @db.Char(3)
  /// month | year
  interval        String    @default("month") @db.VarChar(10)
  /// The store's ID for this price (Paddle, Play, App Store), once set up.
  externalPriceId String?   @unique @map("external_price_id") @db.VarChar(200)

  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  currencyRow Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@index([planId, archivedAt])
  @@index([currency])
  @@map("plan_prices")
  @@schema("reference")
}

/// Billing per audience: on or off, the default plan, trials.
model BillingSettings {
  /// user | business
  audience           String   @id @db.VarChar(10)
  /// For accounts without an active subscription.
  defaultPlanId      BigInt   @map("default_plan_id")
  /// What everyone gets while charging is off.
  planWhenDisabledId BigInt   @map("plan_when_disabled_id")
  /// What a trial gives (null: no trials).
  trialPlanId        BigInt?  @map("trial_plan_id")
  updatedById        BigInt?  @map("updated_by_id")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  trialDays          Int      @default(30) @map("trial_days") @db.SmallInt
  enabled            Boolean  @default(false)
  trialEnabled       Boolean  @default(true) @map("trial_enabled")

  defaultPlan      Plan  @relation("DefaultPlan", fields: [defaultPlanId], references: [id], onDelete: Restrict)
  planWhenDisabled Plan  @relation("PlanWhenDisabled", fields: [planWhenDisabledId], references: [id], onDelete: Restrict)
  trialPlan        Plan? @relation("TrialPlan", fields: [trialPlanId], references: [id], onDelete: Restrict)

  @@index([defaultPlanId])
  @@index([planWhenDisabledId])
  @@index([trialPlanId])
  @@map("billing_settings")
  @@schema("reference")
}

/// What each sales channel keeps (for the profit calculator).
model BillingChannelFee {
  /// web | android | ios
  channel    String   @id @db.VarChar(10)
  fixedMinor BigInt   @default(0) @map("fixed_minor")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  percent    Decimal  @db.Decimal(5, 2)
  currency   String   @default("USD") @db.Char(3)
  notes      String?  @db.VarChar(300)

  @@map("billing_channel_fees")
  @@schema("reference")
}

/// What running BUKU costs per month (for the profit calculator).
model BillingCostItem {
  id           BigInt    @id
  monthlyMinor BigInt    @map("monthly_minor")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  /// infrastructure | messaging | software | other
  category     String    @db.VarChar(30)
  currency     String    @default("USD") @db.Char(3)
  name         String    @db.VarChar(100)
  notes        String?   @db.VarChar(300)

  @@map("billing_cost_items")
  @@schema("reference")
}

/// How notifications go out (one row, id 1; D-073).
model NotificationSettings {
  id                         Int      @id @default(1) @db.SmallInt
  updatedById                BigInt?  @map("updated_by_id")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cap on the month's estimated WhatsApp spend, in US cents; 0: never pay for a message.
  whatsappMonthlyBudgetCents Int      @default(0) @map("whatsapp_monthly_budget_cents")
  /// Replies inside the 24-hour window that Meta doesn't charge for, per month.
  whatsappFreeWindowPerMonth Int      @default(1000) @map("whatsapp_free_window_per_month")
  /// Estimated price of one paid WhatsApp message, in US cents (a rate, not an amount).
  whatsappMessageCostCents   Decimal  @default(4) @map("whatsapp_message_cost_cents") @db.Decimal(8, 4)
  /// Night time (local hours): reminders and suggestions wait until it ends.
  quietStartHour             Int      @default(21) @map("quiet_start_hour") @db.SmallInt
  quietEndHour               Int      @default(9) @map("quiet_end_hour") @db.SmallInt
  suggestionMinDays          Int      @default(7) @map("suggestion_min_days") @db.SmallInt
  suggestionMaxPer30Days     Int      @default(3) @map("suggestion_max_per_30_days") @db.SmallInt
  suggestionMaxIgnored       Int      @default(3) @map("suggestion_max_ignored") @db.SmallInt
  emailEnabled               Boolean  @default(true) @map("email_enabled")
  whatsappEnabled            Boolean  @default(false) @map("whatsapp_enabled")
  reminder24h                Boolean  @default(true) @map("reminder_24h")
  reminder2h                 Boolean  @default(true) @map("reminder_2h")
  suggestionsEnabled         Boolean  @default(true) @map("suggestions_enabled")
  /// Message types that may go as PAID templates outside the free 24-hour window.
  whatsappPaidTypes          String[] @default([]) @map("whatsapp_paid_types")

  @@map("notification_settings")
  @@schema("reference")
}
