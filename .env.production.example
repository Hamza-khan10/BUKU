# ═══════════════════════════════════════════════════════════════════════════
# BUKU — PRODUCTION environment reference (documentation only — no values).
#
# Production secrets NEVER live in a file in this repo or on a laptop. They are
# stored in the deployment platform's secret store (Kubernetes Secrets sealed
# with kubeseal, or DigitalOcean App Platform encrypted env vars — Phase 5) and
# each service receives only the keys it needs.
#
# Differences from .env.example (development) are marked  ⚠ PROD.
# Every service refuses to start in NODE_ENV=production if a secret still
# contains a development placeholder (see packages/common/src/config.ts).
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false                      # ⚠ PROD: JSON logs for Loki/Grafana
TRUST_PROXY_HOPS=2                    # ⚠ PROD: nginx/LB → Kong → service
SHUTDOWN_DELAY_MS=5000                # ⚠ PROD: let the LB drain before closing

# ── Web app → gateway (D-084) ─────────────────────────────────────────────
# ⚠ PROD: set the SAME value in Kong's environment and in the web app's (Vercel)
# server environment. Rotate: deploy Kong and the web app together.
WEB_GATEWAY_KEY=<64 hex>

# ── Admin app → gateway (D-091) ───────────────────────────────────────────
# ⚠ PROD: the SAME value in Kong's environment and in the ADMIN app's server
# environment only (never the public website's). Different from WEB_GATEWAY_KEY.
ADMIN_GATEWAY_KEY=<64 hex>

# ── PostgreSQL (DigitalOcean Managed PostgreSQL 17) ───────────────────────
# ⚠ PROD: TLS required (sslmode=require); connect through the DO connection pool
# (PgBouncer, transaction mode) for services; migrations use the direct URL.
DATABASE_URL=postgresql://buku_app:<secret>@<pool-host>:25061/buku?sslmode=require
DATABASE_MIGRATION_URL=postgresql://buku_migrator:<secret>@<db-host>:25060/buku?sslmode=require
DATABASE_POOL_SIZE=10

# ── Valkey (DigitalOcean Managed Caching / Valkey) ────────────────────────
REDIS_URL=rediss://default:<secret>@<valkey-host>:25061   # ⚠ PROD: rediss:// (TLS)

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BROKERS=<broker-1>:9093,<broker-2>:9093,<broker-3>:9093
KAFKA_SSL=true                        # ⚠ PROD
KAFKA_SASL_MECHANISM=scram-sha-512    # ⚠ PROD
KAFKA_SASL_USERNAME=<per-service user>
KAFKA_SASL_PASSWORD=<secret>
KAFKA_REPLICATION_FACTOR=3            # ⚠ PROD (topic sync)
KAFKA_MIN_INSYNC_REPLICAS=2           # ⚠ PROD (with acks=all → survives one broker loss)

# ── ClickHouse ────────────────────────────────────────────────────────────
# (Search runs on Postgres; no Elasticsearch until volume needs it — D-076.)
CLICKHOUSE_URL=https://<ch-host>:8443                      # ⚠ PROD: TLS
CLICKHOUSE_USER=buku_analytics
CLICKHOUSE_PASSWORD=<secret>

# ── Object storage (DigitalOcean Spaces) ──────────────────────────────────
S3_ENDPOINT=https://<region>.digitaloceanspaces.com
S3_REGION=<region>
S3_ACCESS_KEY_ID=<spaces key, scoped to BUKU buckets>
S3_SECRET_ACCESS_KEY=<secret>
S3_BUCKET_MEDIA=buku-media
S3_BUCKET_DOCUMENTS=buku-documents    # private; presigned URLs only
S3_BUCKET_PRIVATE=buku-private        # private: picture originals (incoming/, 1-day expiry rule) + profile pictures; NEVER behind the CDN
S3_PUBLIC_ENDPOINT=https://<region>.digitaloceanspaces.com   # what browsers use for presigned links
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://<cdn-endpoint>   # DO Spaces CDN for public photos (media bucket)

# ── JWT ───────────────────────────────────────────────────────────────────
# ⚠ PROD: private key ONLY in auth-service's secret. Rotate at least yearly.
JWT_PRIVATE_KEY=<base64 PKCS#8 PEM>
JWT_PUBLIC_KEY=<base64 SPKI PEM>
JWT_KEY_ID=prod-2026-10
JWT_PREVIOUS_PUBLIC_KEY=              # set during a rotation window only
JWT_PREVIOUS_KEY_ID=
JWT_ISSUER=https://auth.buku.app      # ⚠ PROD
JWT_AUDIENCE=buku-api

# ── PII protection ────────────────────────────────────────────────────────
# ⚠ PROD: different keys from dev. Back them up in a password manager/HSM —
# losing PII_ENCRYPTION_KEYS means losing every encrypted email and phone.
PII_ENCRYPTION_KEYS=k1:<base64 32 bytes>
PII_ENCRYPTION_ACTIVE_KEY_ID=k1
PII_BLIND_INDEX_KEY=<base64 32 bytes>

# ── Email (AWS SES over SMTP) ─────────────────────────────────────────────
SMTP_HOST=email-smtp.<region>.amazonaws.com   # ⚠ PROD (dev: mailpit)
SMTP_PORT=587
SMTP_USER=<ses smtp user>
SMTP_PASSWORD=<secret>
EMAIL_FROM=BUKU <noreply@buku.app>    # domain must have SPF, DKIM and DMARC
SMTP_REQUIRE_TLS=true                  # ⚠ PROD: never send email unencrypted
WEB_APP_URL=https://buku.app
PUBLIC_API_URL=https://api.buku.app    # unsubscribe links in emails

# ── Third parties ─────────────────────────────────────────────────────────
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=<token>                # turn on push security in the Expo project
WHATSAPP_PROVIDER=meta
WHATSAPP_BUSINESS_NUMBER=<+E.164>
WHATSAPP_PHONE_NUMBER_ID=<id>
WHATSAPP_ACCESS_TOKEN=<system user token>
WHATSAPP_APP_SECRET=<secret>
WHATSAPP_VERIFY_TOKEN=<random, 32+ chars>
GOOGLE_CLIENT_IDS=<web-id>.apps.googleusercontent.com,<ios-id>,<android-id>
APPLE_SIGN_IN_ENABLED=false            # enable once the Apple Developer account exists
AUTH_DEV_LOGIN_ENABLED=false           # ⚠ PROD: must be false (service refuses to start otherwise)
SESSION_IDLE_TIMEOUT_DAYS=180          # sessions last until logout; expire only after this much inactivity
ADMIN_SESSION_IDLE_TIMEOUT_HOURS=24
TERMS_VERSION=1.0
ACCOUNT_DELETION_GRACE_DAYS=30         # restorable period before irreversible anonymization
REAUTH_WINDOW_MINUTES=10               # account deletion needs a sign-in this recent
MEMBER_LOGIN_MAX_ATTEMPTS=5            # employee accounts: wrong passwords before a lock
MEMBER_LOCKOUT_MINUTES=15
BREACHED_PASSWORD_CHECK=true           # new passwords checked against Have I Been Pwned (k-anonymity); allowed if it's unreachable
MAX_MEMBERS_PER_BUSINESS=1000        # safety cap only: the plan decides (D-065)
APPLE_CLIENT_IDS=app.buku.signin
APPLE_TEAM_ID=<team>
PADDLE_ENVIRONMENT=production         # ⚠ PROD
PADDLE_API_KEY=<secret>
PADDLE_WEBHOOK_SECRET=<secret>         # the notification destination's secret key
PADDLE_CLIENT_TOKEN=<public token>     # client-side token for Paddle.js (safe to expose)
MAPBOX_ACCESS_TOKEN=<public token, URL-restricted to buku.app>

# ── Feature flags ─────────────────────────────────────────────────────────
FEATURE_AI_RECEPTIONIST=false
FEATURE_ADS=true
FEATURE_PAYMENTS=false
