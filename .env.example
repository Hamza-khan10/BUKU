# ═══════════════════════════════════════════════════════════════════════════
# BUKU — environment variables (LOCAL DEVELOPMENT)
#
#   pnpm bootstrap      ← creates .env and fills every secret below for you
#
# Rules
#   • .env is git-ignored and must NEVER be committed (a gitleaks pre-commit
#     hook blocks it). This file documents what exists; it holds no secrets.
#   • docker-compose.dev.yml passes each service ONLY the variables it needs
#     (e.g. only auth-service ever sees JWT_PRIVATE_KEY).
#   • Production values are documented in .env.production.example.
#
# Legend:  [REQUIRED]  generated by `pnpm bootstrap` if empty
#          [OPTIONAL]  third-party credentials; features degrade gracefully
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Three roles (see docker/postgres/init): superuser for ops only, a migrator
# that owns the schema, and a data-only app role that services connect as.
# [REQUIRED] hex, 32+ chars
POSTGRES_SUPERUSER_PASSWORD=
# [REQUIRED] used by `prisma migrate`
BUKU_MIGRATOR_PASSWORD=
# [REQUIRED] used by all services at runtime
BUKU_APP_PASSWORD=
POSTGRES_HOST_PORT=5432          # host port bound to 127.0.0.1

# ── Valkey (Redis-compatible cache, locks, BullMQ jobs) ───────────────────
# [REQUIRED]
VALKEY_PASSWORD=

# ── ClickHouse (analytics OLAP) ───────────────────────────────────────────
# [REQUIRED]
CLICKHOUSE_PASSWORD=

# ── Object storage (S3-compatible; RustFS locally, DO Spaces in prod) ─────
# [REQUIRED] local RustFS admin key
S3_ACCESS_KEY_ID=
# [REQUIRED]
S3_SECRET_ACCESS_KEY=

# ── JWT (RS256) ───────────────────────────────────────────────────────────
# Base64-encoded PEM (single line). Private key: auth-service ONLY.
# Rotate: generate a new pair with a new JWT_KEY_ID, deploy the new public
# key everywhere first, then switch signing.
# [REQUIRED] PKCS#8 RSA 2048
JWT_PRIVATE_KEY=
# [REQUIRED] SPKI
JWT_PUBLIC_KEY=
# [REQUIRED] e.g. dev-2026-09
JWT_KEY_ID=
JWT_ISSUER=https://auth.buku.local
JWT_AUDIENCE=buku-api

# ── PII protection ────────────────────────────────────────────────────────
# Keyring for AES-256-GCM field encryption: "<id>:<base64 32 bytes>,..."
# [REQUIRED]
PII_ENCRYPTION_KEYS=
PII_ENCRYPTION_ACTIVE_KEY_ID=k1
# HMAC key for blind indexes (email/phone lookups). NEVER rotate casually:
# every stored hash would have to be recomputed.
# [REQUIRED] base64, 32 bytes
PII_BLIND_INDEX_KEY=

# ── Push ──────────────────────────────────────────────────────────────────
# Push notifications: log (development) or expo (the Expo app)
PUSH_PROVIDER=log
# Optional: Expo access token (needed once push security is on in the Expo project)
EXPO_ACCESS_TOKEN=

# ── Email links ───────────────────────────────────────────────────────────
# Where "Open in BUKU" buttons in emails go (the web app)
WEB_APP_URL=http://localhost:3000

# ── WhatsApp (Meta WhatsApp Cloud API) ── business.facebook.com ───────────
# log (development: written to the log) or meta. Nothing is sent until an admin
# switches WhatsApp on in notification settings. Setup: docs/DEVELOPMENT.md.
WHATSAPP_PROVIDER=log
# Our WhatsApp number (E.164, e.g. +923001234567), for "connect WhatsApp" links
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token (never a 24-hour temporary token)
WHATSAPP_ACCESS_TOKEN=
# Meta app secret (checks webhook signatures)
WHATSAPP_APP_SECRET=
# Any long random string; typed into Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=

# ── Social login ──────────────────────────────────────────────────────────
# [OPTIONAL] comma-separated OAuth client ids (web, iOS, Android); empty → Google sign-in off
GOOGLE_CLIENT_IDS=
# [LOCKED] needs the Apple Developer Program ($99/yr) — D-028
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=

# ── Paddle (subscriptions + ad purchases) ── vendors.paddle.com ───────────
PADDLE_ENVIRONMENT=sandbox       # sandbox | production
# [OPTIONAL in dev]
PADDLE_API_KEY=
# [OPTIONAL in dev]
PADDLE_WEBHOOK_SECRET=
# [OPTIONAL in dev] public token for Paddle.js; set all three PADDLE_* keys or none
PADDLE_CLIENT_TOKEN=

# ── Maps ──────────────────────────────────────────────────────────────────
# [OPTIONAL] public token (web/mobile), URL-restricted
MAPBOX_ACCESS_TOKEN=

# ── Feature flags ─────────────────────────────────────────────────────────
FEATURE_AI_RECEPTIONIST=false
FEATURE_ADS=true
FEATURE_PAYMENTS=false
