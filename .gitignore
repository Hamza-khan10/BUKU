# ── Dependencies & build output ──
node_modules/
dist/
coverage/
*.tsbuildinfo
.turbo/

# ── Generated code (regenerated by `pnpm db:generate`) ──
packages/database/src/generated/

# ── Secrets: NEVER commit. Only the *.example files are tracked. ──
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
secrets/

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ── Logs ──
*.log
npm-debug.log*
pnpm-debug.log*

# ── Legacy upload artifacts (kept out of the tree on purpose) ──
*.zip
